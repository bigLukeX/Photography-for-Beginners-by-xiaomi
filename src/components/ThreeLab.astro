<section class="three-lab" data-three-lab>
  <div class="three-lab__intro">
    <span class="lab-panel__kicker">Three.js 实验</span>
    <h3>3D 焦距、透视与光线方向</h3>
    <p>这组实验用真正的 3D 场景演示空间关系：你能看到相机位置、视角和灯光方向如何改变主体、背景和阴影。</p>
  </div>

  <div class="lab-grid">
    <article class="lab-panel">
      <div class="lab-panel__header">
        <h3>3D 焦距与透视</h3>
        <p>先固定距离只改视角；再勾选“保持主体大小”并后退，比较背景相对人物的变化。</p>
      </div>
      <div class="three-lab__viewport" data-three-perspective></div>
      <div class="lab-controls lab-controls--split">
        <label for="three-distance">
          相机距离
          <input id="three-distance" name="three-distance" type="range" min="3.2" max="9" value="5.2" step="0.1" data-three-distance />
        </label>
        <label for="three-fov">
          视角宽窄
          <input id="three-fov" name="three-fov" type="range" min="20" max="90" value="48" step="any" data-three-fov />
        </label>
      </div>
      <label class="lab-checkbox"><input type="checkbox" data-three-lock-size /> 保持主体大小（移动距离时自动配合视角）</label>
      <p class="lab-readout" aria-live="polite" data-three-perspective-readout>固定站位只改视角，不改变前后物体的大小比例。</p>
    </article>

    <article class="lab-panel">
      <div class="lab-panel__header">
        <h3>3D 光线方向</h3>
        <p>让灯绕着主体移动，观察顺光、侧光、逆光和顶光如何改变阴影。</p>
      </div>
      <div class="three-lab__viewport" data-three-light></div>
      <div class="lab-controls lab-controls--split">
        <label for="three-light-angle">
          光线方向
          <input id="three-light-angle" name="three-light-angle" type="range" min="0" max="360" value="135" step="1" data-three-light-angle />
        </label>
        <label for="three-light-height">
          光线高度
          <input id="three-light-height" name="three-light-height" type="range" min="1.2" max="6" value="3.2" step="0.1" data-three-light-height />
        </label>
      </div>
      <p class="lab-readout" aria-live="polite" data-three-light-readout>0° 为相机一侧的顺光，180° 为主体背后的逆光。</p>
      <p class="lab-note">高度改变阴影方向；光的软硬主要取决于光源相对主体的大小。本模型使用固定的方向光，不模拟柔光箱尺寸。</p>
    </article>
  </div>
</section>

<script>
  import { lightDirection, lockedFieldOfView } from '../lib/photo-lab-model.mjs';

  const initThreeLabs = async () => {
    const {
      BoxGeometry,
      CapsuleGeometry,
      Color,
      DirectionalLight,
      Group,
      HemisphereLight,
      Mesh,
      MeshBasicMaterial,
      MeshStandardMaterial,
      PCFShadowMap,
      PerspectiveCamera,
      PlaneGeometry,
      Scene,
      SphereGeometry,
      WebGLRenderer,
    } = await import('three');

    const labs = document.querySelectorAll('[data-three-lab]');

  const makeRenderer = (container) => {
    const renderer = new WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = PCFShadowMap;
    container.appendChild(renderer.domElement);
    return renderer;
  };

  const addPerson = (scene, x = 0, z = 0) => {
    const group = new Group();
    group.position.set(x, 0, z);
    const bodyMaterial = new MeshStandardMaterial({ color: '#8a6a4c', roughness: 0.7 });
    const headMaterial = new MeshStandardMaterial({ color: '#e9aa4e', roughness: 0.58 });
    const body = new Mesh(new CapsuleGeometry(0.42, 1.2, 12, 24), bodyMaterial);
    body.position.y = 1.05;
    const head = new Mesh(new SphereGeometry(0.34, 32, 24), headMaterial);
    head.position.y = 2.08;
    body.castShadow = true;
    head.castShadow = true;
    group.add(body, head);
    scene.add(group);
    return group;
  };

  const addGround = (scene) => {
    const ground = new Mesh(
      new PlaneGeometry(18, 14),
      new MeshStandardMaterial({ color: '#d8cbb8', roughness: 0.82 })
    );
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);
  };

  const addBackgroundColumns = (scene) => {
    const colors = ['#5e6172', '#a98152', '#74665d', '#4e5265', '#c4a069'];
    [-4.2, -2, 0.5, 2.5, 4.4].forEach((x, index) => {
      const height = 1.6 + (index % 3) * 0.55;
      const column = new Mesh(
        new BoxGeometry(0.62, height, 0.62),
        new MeshStandardMaterial({ color: colors[index], roughness: 0.74 })
      );
      column.position.set(x, height / 2, -3.6 - (index % 2) * 0.9);
      column.castShadow = true;
      column.receiveShadow = true;
      scene.add(column);
    });
  };

  const makeBaseScene = () => {
    const scene = new Scene();
    scene.background = new Color('#f1e8dc');
    addGround(scene);
    addBackgroundColumns(scene);
    const ambient = new HemisphereLight('#f6e6c8', '#6d7480', 1.45);
    scene.add(ambient);
    return scene;
  };

  const setupPerspectiveLab = (root) => {
    const container = root.querySelector('[data-three-perspective]');
    const distanceInput = root.querySelector('[data-three-distance]');
    const fovInput = root.querySelector('[data-three-fov]');
    const lockSize = root.querySelector('[data-three-lock-size]');
    const readout = root.querySelector('[data-three-perspective-readout]');
    if (!container || !distanceInput || !fovInput) return null;

    const scene = makeBaseScene();
    addPerson(scene);
    const key = new DirectionalLight('#ffe0a6', 2.3);
    key.position.set(-3, 5, 4);
    key.castShadow = true;
    scene.add(key);

    const camera = new PerspectiveCamera(48, container.clientWidth / container.clientHeight, 0.1, 50);
    const renderer = makeRenderer(container);
    let referenceDistance = Number(distanceInput.value);
    let referenceFov = Number(fovInput.value);

    const update = () => {
      const distance = Number(distanceInput.value);
      if (lockSize.checked) {
        const lockedFov = lockedFieldOfView(referenceDistance, referenceFov, distance);
        // Expand the display range instead of silently clamping the framing lock.
        fovInput.min = String(Math.min(20, lockedFov));
        fovInput.max = String(Math.max(90, lockedFov));
        fovInput.value = String(lockedFov);
      }
      fovInput.disabled = lockSize.checked;
      const fov = Number(fovInput.value);
      camera.fov = fov;
      camera.position.set(0, 1.25, distance);
      camera.lookAt(0, 1.25, 0);
      camera.updateProjectionMatrix();
      readout.textContent = '距离 ' + distance.toFixed(1) + '，垂直视角 ' + fov.toFixed(1) + '°。' + (lockSize.checked
        ? '人物大小保持不变；向后移动时，背景相对人物变大。'
        : '固定距离只改变视角，人物和背景一起缩放；前后大小比例不变。');
      renderer.render(scene, camera);
    };

    distanceInput.addEventListener('input', update);
    fovInput.addEventListener('input', update);
    lockSize.addEventListener('change', () => {
      if (lockSize.checked) {
        referenceDistance = Number(distanceInput.value);
        referenceFov = Number(fovInput.value);
      }
      update();
    });
    update();
    return { container, renderer, camera, scene, update };
  };

  const setupLightLab = (root) => {
    const container = root.querySelector('[data-three-light]');
    const angleInput = root.querySelector('[data-three-light-angle]');
    const heightInput = root.querySelector('[data-three-light-height]');
    const readout = root.querySelector('[data-three-light-readout]');
    if (!container || !angleInput || !heightInput) return null;

    const scene = makeBaseScene();
    addPerson(scene);
    const lightMarker = new Mesh(
      new SphereGeometry(0.16, 24, 16),
      new MeshBasicMaterial({ color: '#ffd46f' })
    );
    scene.add(lightMarker);
    const key = new DirectionalLight('#ffe0a6', 3);
    key.castShadow = true;
    key.target.position.set(0, 1.2, 0);
    scene.add(key, key.target);
    const camera = new PerspectiveCamera(46, container.clientWidth / container.clientHeight, 0.1, 50);
    camera.position.set(0, 2.35, 6.4);
    camera.lookAt(0, 1.1, -0.3);
    const renderer = makeRenderer(container);

    const update = () => {
      const angle = Number(angleInput.value) * Math.PI / 180;
      const height = Number(heightInput.value);
      const radius = 4;
      key.position.set(Math.sin(angle) * radius, height, Math.cos(angle) * radius);
      lightMarker.position.copy(key.position);
      const direction = lightDirection(Number(angleInput.value));
      let note = angleInput.value + '° · ' + direction + '：' + {
        '顺光': '光来自相机一侧，正面受光。',
        '侧光': '光来自主体侧面，明暗分区更明显。',
        '逆光': '光来自主体背后，正面较暗，边缘可能发亮。',
      }[direction];
      if (height > 4.6) note += ' 光位较高，阴影会更往下压。';
      if (height < 2) note += ' 光位较低，留意脸部与身体阴影的方向。';
      readout.textContent = note;
      renderer.render(scene, camera);
    };

    angleInput.addEventListener('input', update);
    heightInput.addEventListener('input', update);
    update();
    return { container, renderer, camera, scene, update };
  };

  labs.forEach((root) => {
    const scenes = [
      [setupPerspectiveLab, '[data-three-perspective]'],
      [setupLightLab, '[data-three-light]'],
    ].map(([setup, selector]) => {
      try {
        return setup(root);
      } catch {
        root.querySelector(selector).textContent = '当前浏览器无法显示 3D。请使用上方平面实验，并阅读本面板的方向说明。';
        return null;
      }
    }).filter(Boolean);
    const resize = () => {
      scenes.forEach((item) => {
        item.camera.aspect = item.container.clientWidth / item.container.clientHeight;
        item.camera.updateProjectionMatrix();
        item.renderer.setSize(item.container.clientWidth, item.container.clientHeight);
        item.update();
      });
    };
    const observer = new ResizeObserver(resize);
    scenes.forEach((item) => observer.observe(item.container));
    resize();
  });

  };

  const threeLabRoot = document.querySelector('[data-three-lab]');
  let threeLabStarted = false;

  const startThreeLabs = () => {
    if (threeLabStarted) return;
    threeLabStarted = true;
    void initThreeLabs().catch(() => {
      threeLabRoot.querySelectorAll('.three-lab__viewport').forEach((container) => {
        container.textContent = '3D 模块未加载成功。可刷新重试，或继续使用上方平面实验。';
      });
    });
  };

  if (threeLabRoot && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      startThreeLabs();
    }, { rootMargin: '320px 0px' });
    observer.observe(threeLabRoot);
  } else if (threeLabRoot) {
    startThreeLabs();
  }
</script>
