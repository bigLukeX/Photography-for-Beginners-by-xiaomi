---
interface Props {
  src: string;
  label: string;
}
const { src, label } = Astro.props;
---

<a href={src} class="image-zoom-link" data-photo-zoom data-photo-description={label} aria-label={`放大查看：${label}`}>
  <slot />
</a>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-photo-zoom]');
  if (links.length) {
    const dialog = document.createElement('dialog');
    dialog.className = 'photo-zoom';
    dialog.setAttribute('aria-label', '图片大图查看器');
    dialog.innerHTML = '<div class="photo-zoom__bar"><button type="button" data-close>关闭大图</button><button type="button" data-size aria-pressed="false">实际尺寸</button></div><div class="photo-zoom__viewport" tabindex="0" aria-label="图片区域，可滚动查看细节"><img alt="" /></div><p class="photo-zoom__caption"></p>';
    document.body.append(dialog);
    const image = dialog.querySelector('img')!;
    const sizeButton = dialog.querySelector<HTMLButtonElement>('[data-size]')!;
    const caption = dialog.querySelector('.photo-zoom__caption')!;
    let opener: HTMLAnchorElement | undefined;
    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        image.src = link.href;
        image.alt = link.dataset.photoDescription ?? '';
        caption.textContent = image.alt;
        dialog.classList.remove('photo-zoom--actual');
        sizeButton.setAttribute('aria-pressed', 'false');
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    sizeButton.addEventListener('click', () => {
      const actual = dialog.classList.toggle('photo-zoom--actual');
      sizeButton.setAttribute('aria-pressed', String(actual));
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>
