---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageZoom from './ImageZoom.astro';

interface VisualLabel {
  title: string;
  detail: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  labels?: VisualLabel[];
  note?: string;
  eager?: boolean;
}

const {
  src,
  alt,
  labels = [],
  note = 'AI 生成的教学模拟图，用于比较拍摄选择，不是小米 15 Ultra 的实机测试或参数校准样张。',
  eager = false,
} = Astro.props;
const isTriptych = labels.length === 3;
// Read dimensions from the processed result: reading the imported asset's
// properties directly tells Astro to retain the unoptimized original too.
const originalSize = await getImage({ src, format: 'webp', quality: 84 });
const sourceWidth = Number(originalSize.attributes.width);
const sourceHeight = Number(originalSize.attributes.height);
const zoom = sourceWidth > 1600
  ? await getImage({ src, width: 1600, format: 'webp', quality: 84 })
  : originalSize;
const panelWidth = Math.round(sourceWidth / 3);
const positions = ['left', 'center', 'right'] as const;
---

<figure class="generated-lesson-visual">
  {isTriptych ? (
    <>
      <p class="generated-lesson-visual__hint">三幅教学模拟图。窄屏左右滑动逐幅看，点图可放大。</p>
      <div class="generated-lesson-visual__panels" tabindex="0" role="group" aria-label={alt}>
        {labels.map((label, index) => (
          <div class="generated-lesson-visual__panel">
            <ImageZoom src={zoom.src} label={`AI 教学模拟：${alt}`}>
              <Image
                src={src}
                alt={`${index + 1}. ${label.title}：${label.detail}（AI 教学模拟）`}
                width={panelWidth}
                height={sourceHeight}
                widths={[256, 384, panelWidth]}
                sizes="(max-width: 49.99rem) calc(86vw - 1.72rem), (max-width: 64rem) calc(86vw - 17.2rem), 15rem"
                fit="cover"
                position={positions[index]}
                format="webp"
                quality={84}
                loading={eager ? 'eager' : 'lazy'}
              />
            </ImageZoom>
            <p><strong>{index + 1}. {label.title}</strong>{label.detail}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <ImageZoom src={zoom.src} label={`AI 教学模拟：${alt}`}>
      <Image src={src} alt={alt} width={Math.min(1600, sourceWidth)} widths={[480, 768, 1280, Math.min(1600, sourceWidth)]} sizes="(max-width: 49.99rem) calc(100vw - 2rem), (max-width: 64rem) calc(100vw - 20rem), 45rem" quality={84} format="webp" loading={eager ? 'eager' : 'lazy'} />
    </ImageZoom>
  )}
  {!isTriptych && labels.length > 0 && (
    <div
      class="generated-lesson-visual__labels"
      style={`--visual-columns: ${labels.length};`}
      role="list"
      aria-label="图片分栏说明"
    >
      {labels.map((label) => (
        <span role="listitem">
          <strong>{label.title}</strong>
          {label.detail}
        </span>
      ))}
    </div>
  )}
  <figcaption>{note} 点图查看完整大图；“实际尺寸”显示本站优化文件的像素尺寸。</figcaption>
</figure>
